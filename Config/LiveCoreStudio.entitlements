<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime resource access. The app is not sandboxed in Milestone 1 (see docs/PACKAGING.md). -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Load the NDI runtime installed by NDI Tools / NDI Runtime (signed by NDI, not by us). -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- Ask Keynote / PowerPoint to export a presentation input to PDF (0.35.0). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
